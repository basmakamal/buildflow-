{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@buildflow/core": ["../../packages/core/src/index.ts"],
      "@buildflow/database": ["../../packages/database/src/index.ts"],
      "@buildflow/identity": ["../../packages/modules/identity/src/index.ts"],
      "@buildflow/project": ["../../packages/modules/project/src/index.ts"],
      "@buildflow/execution": ["../../packages/modules/execution/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
