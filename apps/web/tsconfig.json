{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "jsx": "preserve",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@buildflow/ui": ["../../packages/ui/src/index.ts"],
      "@buildflow/spatial": ["../../packages/modules/spatial/src/index.ts"],
      "@buildflow/estimation/pricing": ["../../packages/modules/estimation/src/pricing.ts"],
      "@buildflow/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "test/**/*.ts", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
