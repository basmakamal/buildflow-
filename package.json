{
  "name": "buildflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Construction & Interior Finishing Management Platform",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "postinstall": "prisma generate --schema packages/database/prisma/schema.prisma",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,vue,json,md,css,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,vue,json,md,css,mjs}\"",
    "arch": "depcruise --config .dependency-cruiser.cjs packages",
    "icons:build": "pnpm --filter @buildflow/ui icons:build",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm arch && pnpm icons:build",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker-compose.yml down -v && pnpm infra:up"
  },
  "pnpm": {
    "overrides": {
      "vite": ">=6.4.3"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "dependency-cruiser": "^16.5.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.30.0",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vue-eslint-parser": "^9.4.3"
  }
}
