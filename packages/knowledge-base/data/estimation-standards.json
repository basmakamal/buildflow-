[
  {
    "code": "est_paint_quantity",
    "name_en": "Paint Quantity (per coat)",
    "name_ar": "كمية الدهان (للوجه)",
    "trade": "painting",
    "output_unit": "L",
    "inputs": [
      {
        "var": "area_m2",
        "label_en": "Paintable area",
        "unit": "m2"
      },
      {
        "var": "coats",
        "label_en": "Number of coats",
        "unit": "count"
      },
      {
        "var": "coverage_m2_per_l",
        "label_en": "Coverage rate",
        "unit": "m2/L"
      }
    ],
    "formula": "area_m2 * coats / coverage_m2_per_l",
    "waste_pct": "10.00",
    "notes_en": "Coverage defaults: emulsion 10-12 m²/L smooth, 8-9 m²/L textured, primer 10 m²/L, enamel 12-14 m²/L. Waste 10% covers touch-ups and tray losses; use 15% for spray application.",
    "is_active": 1
  },
  {
    "code": "est_paint_wall_area",
    "name_en": "Paintable Wall Area",
    "name_ar": "مساحة الجدران للدهان",
    "trade": "painting",
    "output_unit": "m2",
    "inputs": [
      {
        "var": "perimeter_m",
        "label_en": "Room perimeter",
        "unit": "m"
      },
      {
        "var": "height_m",
        "label_en": "Ceiling height",
        "unit": "m"
      },
      {
        "var": "openings_m2",
        "label_en": "Doors + windows area",
        "unit": "m2"
      }
    ],
    "formula": "perimeter_m * height_m - openings_m2",
    "waste_pct": "0.00",
    "notes_en": "Deduct openings only above 0.5 m² each. Perimeter = 2*(L+W) for rectangular rooms.",
    "is_active": 1
  },
  {
    "code": "est_primer_quantity",
    "name_en": "Primer Quantity",
    "name_ar": "كمية البرايمر",
    "trade": "painting",
    "output_unit": "L",
    "inputs": [
      {
        "var": "area_m2",
        "label_en": "Area",
        "unit": "m2"
      }
    ],
    "formula": "area_m2 / 10",
    "waste_pct": "8.00",
    "notes_en": "Single sealer coat at 10 m²/L. Raise to 8 m²/L on new porous plaster.",
    "is_active": 1
  },
  {
    "code": "est_putty_quantity",
