    ],
    "formula": "area_m2 * coats * 0.8",
    "waste_pct": "12.00",
    "notes_en": "~0.8 kg/m² per coat at 1 mm. Two coats standard, three on gypsum under gloss.",
    "is_active": 1
  },
  {
    "code": "est_grout",
    "name_en": "Grout Quantity",
    "name_ar": "كمية الروبة",
    "trade": "flooring",
    "output_unit": "kg",
    "inputs": [
      {
        "var": "area_m2",
        "label_en": "Area",
        "unit": "m2"
      },
      {
        "var": "tile_w_cm",
        "label_en": "Tile width",
        "unit": "cm"
      },
      {
        "var": "tile_h_cm",
        "label_en": "Tile length",
        "unit": "cm"
      },
      {
        "var": "joint_mm",
        "label_en": "Joint width",
        "unit": "mm"
      },
      {
        "var": "thickness_mm",
        "label_en": "Tile thickness",
        "unit": "mm"
      }
    ],
    "formula": "1.6 * ((tile_w_cm + tile_h_cm) / (tile_w_cm * tile_h_cm)) * joint_mm * thickness_mm * area_m2",
    "waste_pct": "10.00",
    "notes_en": "Standard grout density factor 1.6 kg/dm³. Typical result: 0.3-0.5 kg/m² for 60x60 with 3 mm joints.",
    "is_active": 1
  },
  {
    "code": "est_screed_volume",
    "name_en": "Screed Volume",
    "name_ar": "حجم اللياسة الأرضية",
    "trade": "flooring",
    "output_unit": "m3",
    "inputs": [
      {
        "var": "area_m2",
        "label_en": "Area",
        "unit": "m2"
      },
      {
        "var": "thickness_cm",
        "label_en": "Screed thickness",
        "unit": "cm"
      }
    ],
    "formula": "area_m2 * thickness_cm / 100",
    "waste_pct": "8.00",
    "notes_en": "Cement:sand 1:4 → per m³ ≈ 320 kg cement + 1.15 m³ sand. Min 25 mm bonded, 50 mm unbonded.",
    "is_active": 1
  },
