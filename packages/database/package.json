{
  "name": "@buildflow/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:deploy": "prisma db push --schema prisma/schema.prisma --skip-generate --accept-data-loss",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "test": "vitest run",
    "test:isolation": "vitest run test/tenant-isolation.test.ts"
  },
  "dependencies": {
    "@buildflow/core": "workspace:*",
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
