// BuildFlow — Phase 0 schema slice.
//
// Deliberately partial. This covers tenancy, identity, and enough of the
// project hierarchy to prove tenant isolation end to end. The full ~90-table
// schema in docs/04 lands module by module; a schema is only worth writing once
// the code that enforces its invariants exists alongside it.
//
// CONVENTIONS (docs/04 §1):
//   • id       CHAR(36) holding UUIDv7 — time-ordered, offline-generatable
//   • companyId on EVERY tenant-owned table
//   • every tenant-scoped index is prefixed with companyId
//   • money     Decimal(18,4) + currency, never Float
//   • version   optimistic concurrency token on aggregate roots
//   • deletedAt soft delete

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// The tenant. Every other row in the database belongs to exactly one of these.
model Company {
  id       String @id @db.Char(36)
  nameEn   String @db.VarChar(200)
  nameAr   String @db.VarChar(200)
  slug     String @unique @db.VarChar(80)

  countryCode       String  @db.Char(2)
  defaultCurrency   String  @db.Char(3)
  defaultLocale     String  @default("ar-SA") @db.VarChar(10)
  timezone          String  @default("Asia/Riyadh") @db.VarChar(64)
  measurementSystem MeasurementSystem @default(metric)
  /// 0 = Sunday. Sunday in KSA/EG/AE, Monday in the EU. Every working-day
  /// calculation depends on this — a hard-coded Sat/Sun weekend reports every
  /// Gulf project as permanently delayed. docs/12 §5
  weekStartDay      Int     @default(0) @db.TinyInt

  status  CompanyStatus @default(trial)
  /// Enterprise tenants can be moved to their own database with no application
  /// change — the connection registry already resolves per tenant. docs/03 §5.4
  dbMode  DbMode        @default(shared)
  dataRegion String     @default("me-south-1") @db.VarChar(32)

  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)
  deletedAt DateTime? @db.DateTime(3)
  version   Int       @default(0) @db.UnsignedInt

  users    User[]
  projects Project[]
  units    Unit[]

  @@map("companies")
}

model User {
  id        String @id @db.Char(36)
  companyId String @db.Char(36)

  email        String  @db.VarChar(255)
  mobile       String? @db.VarChar(20)
  passwordHash String  @db.VarChar(255)
  firstNameEn  String  @db.VarChar(100)
  lastNameEn   String  @db.VarChar(100)
  firstNameAr  String? @db.VarChar(100)
  lastNameAr   String? @db.VarChar(100)
  locale       String  @default("ar-SA") @db.VarChar(10)

  status          UserStatus @default(invited)
  mfaEnabled      Boolean    @default(false)
  lastLoginAt     DateTime?  @db.DateTime(3)
  failedLoginCount Int       @default(0) @db.TinyInt
  lockedUntil     DateTime?  @db.DateTime(3)

  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)
  deletedAt DateTime? @db.DateTime(3)
  version   Int       @default(0) @db.UnsignedInt

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  roles    UserRole[]
  sessions Session[]

  /// Email is unique PER COMPANY, not globally: the same person may legitimately
  /// be a site engineer at one contractor and a client of another. docs/04 §2.2
  @@unique([companyId, email])
  @@index([companyId, status])
  @@map("users")
}

/// Roles are compositions of fine-grained permissions, never hard-coded checks.
/// companyId is null for system roles shared by every tenant. docs/11 §3.2
model Role {
  id        String  @id @db.Char(36)
  companyId String? @db.Char(36)

  code        String  @db.VarChar(64)
  nameEn      String  @db.VarChar(120)
  nameAr      String  @db.VarChar(120)
  description String? @db.VarChar(255)
  isSystem    Boolean @default(false)
  isDefault   Boolean @default(false)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, code])
  @@map("roles")
}

/// Global catalogue. `resource.action`, e.g. unit.update, cost.view.
model Permission {
  id            String  @id @db.Char(36)
  code          String  @unique @db.VarChar(80)
  resource      String  @db.VarChar(40)
  action        String  @db.VarChar(40)
  module        String  @db.VarChar(40)
  descriptionEn String  @db.VarChar(255)
  descriptionAr String  @db.VarChar(255)
  /// Requires a second reviewer when granted — hard delete, cost override.
  isDangerous   Boolean @default(false)

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Char(36)
  permissionId String @db.Char(36)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @db.Char(36)
  roleId     String   @db.Char(36)
  companyId  String   @db.Char(36)
  assignedBy String?  @db.Char(36)
  assignedAt DateTime @default(now()) @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([companyId, userId])
  @@map("user_roles")
}

/// The ABAC dimension: which projects/units a user may act on. A site engineer
/// with unit.update still only sees their assigned projects. docs/11 §3.1
model UserAssignment {
  id        String @id @db.Char(36)
  companyId String @db.Char(36)
  userId    String @db.Char(36)

  scopeType   AssignmentScope
  scopeId     String   @db.Char(36)
  roleInScope String?  @db.VarChar(64)
  assignedBy  String?  @db.Char(36)
  assignedAt  DateTime @default(now()) @db.DateTime(3)
  revokedAt   DateTime? @db.DateTime(3)

  @@index([companyId, userId, scopeType, scopeId])
  @@map("user_assignments")
}

model Session {
  id        String @id @db.Char(36)
  companyId String @db.Char(36)
  userId    String @db.Char(36)

  deviceId   String? @db.VarChar(120)
  deviceName String? @db.VarChar(120)
  platform   String? @db.VarChar(40)
  ipAddress  String? @db.VarChar(45)
  userAgent  String? @db.VarChar(400)

  createdAt    DateTime  @default(now()) @db.DateTime(3)
  lastSeenAt   DateTime  @default(now()) @db.DateTime(3)
  expiresAt    DateTime  @db.DateTime(3)
  revokedAt    DateTime? @db.DateTime(3)
  revokeReason String?   @db.VarChar(120)

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens RefreshToken[]

  @@index([companyId, userId, revokedAt])
  @@map("sessions")
}

/// Rotating refresh tokens with family-based reuse detection.
///
/// Only the SHA-256 hash is stored — never the token. A database dump must not
/// yield usable credentials. `familyId` links every token descended from one
/// login; presenting an already-used token means it was stolen, and the whole
/// family is revoked. docs/11 §2.3
model RefreshToken {
  id        String @id @db.Char(36)
  companyId String @db.Char(36)
  sessionId String @db.Char(36)
  userId    String @db.Char(36)

  tokenHash String  @db.Char(64)
  familyId  String  @db.Char(36)
  parentId  String? @db.Char(36)

  issuedAt     DateTime  @default(now()) @db.DateTime(3)
  expiresAt    DateTime  @db.DateTime(3)
  usedAt       DateTime? @db.DateTime(3)
  revokedAt    DateTime? @db.DateTime(3)
  revokeReason String?   @db.VarChar(120)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([familyId])
  @@index([companyId, userId])
  @@map("refresh_tokens")
}

/// Append-only. Written INSIDE the same transaction as the change it records —
/// an async audit write that fails leaves a change with no record, which
/// defeats the purpose. No application code may update or delete a row here.
/// docs/04 §4, docs/11 §7
model AuditLog {
  id        String  @id @db.Char(36)
  companyId String  @db.Char(36)

  actorUserId String?   @db.Char(36)
  actorType   ActorType @default(user)

  action      String  @db.VarChar(80)
  entityType  String  @db.VarChar(60)
  entityId    String  @db.Char(36)
  entityLabel String? @db.VarChar(200)

  before        Json?
  after         Json?
  changedFields Json?
  /// Mandatory for stage rejection, cost override, hard delete, permission
  /// change and project hold — enforced in the application layer.
  reason        String? @db.VarChar(500)

  ipAddress String?     @db.VarChar(45)
  userAgent String?     @db.VarChar(400)
  requestId String?     @db.VarChar(64)
  source    EventSource @default(web)

  occurredAt DateTime @default(now()) @db.DateTime(3)

  @@index([companyId, entityType, entityId, occurredAt])
  @@index([companyId, actorUserId, occurredAt])
  @@index([companyId, action, occurredAt])
  @@map("audit_logs")
}

/// Retained 90 days for brute-force detection. Not tenant-scoped by design:
/// a failed login may reference an email that matches no company.
model LoginAttempt {
  id            String   @id @db.Char(36)
  companyId     String?  @db.Char(36)
  email         String   @db.VarChar(255)
  ipAddress     String?  @db.VarChar(45)
  userAgent     String?  @db.VarChar(400)
  success       Boolean
  failureReason String?  @db.VarChar(60)
  attemptedAt   DateTime @default(now()) @db.DateTime(3)

  @@index([email, attemptedAt])
  @@index([ipAddress, attemptedAt])
  @@map("login_attempts")
}

enum AssignmentScope {
  company
  branch
  project
  unit
  client
}

enum ActorType {
  user
  system
  api
  job
}

enum EventSource {
  web
  mobile
  api
  system
}

model Project {
  id        String @id @db.Char(36)
  companyId String @db.Char(36)

  code   String @db.VarChar(32)
  nameEn String @db.VarChar(200)
  nameAr String @db.VarChar(200)

  status          ProjectStatus @default(planned)
  contractValue   Decimal?      @db.Decimal(18, 4)
  currency        String        @db.Char(3)
  plannedStartDate DateTime?    @db.Date
  plannedEndDate   DateTime?    @db.Date
  progressPercentage Decimal    @default(0) @db.Decimal(5, 2)

  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)
  deletedAt DateTime? @db.DateTime(3)
  version   Int       @default(0) @db.UnsignedInt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  units   Unit[]

  @@unique([companyId, code])
  @@index([companyId, status, plannedEndDate])
  @@map("projects")
}

/// A separate aggregate root, NOT a child of Project.
///
/// A tower project may hold 200 units. Loading the project aggregate to update
/// one unit's progress would load hundreds of rows and serialise every
/// concurrent site update behind one version column. docs/18 ADR-006
model Unit {
  id        String @id @db.Char(36)
  companyId String @db.Char(36)
  projectId String @db.Char(36)

  /// May differ from the project's client: a developer's tower contains units
  /// owned by many different end clients. docs/05 §3
  ownerClientId String? @db.Char(36)

  unitNumber String @db.VarChar(32)
  name       String @db.VarChar(200)
  floor      Int?   @db.SmallInt

  grossArea     Decimal @db.Decimal(12, 4)
  ceilingHeight Decimal @default(3.0) @db.Decimal(6, 3)

  handoverCondition HandoverCondition @default(red_brick)

  /// The unit's programme, as three facts the AI engine reasons over.
  ///
  /// Nullable rather than defaulted: the engine must distinguish "nobody has
  /// said" from "standard finish". A default would silently answer 19 rule
  /// conditions with a guess, and those rules would then fire — or stay
  /// silent — on data no one supplied. Absent means the rule SKIPS and the
  /// review screen says which fact would unlock it. docs/10
  unitType     UnitType?     
  finishLevel  FinishLevel?  
  occupantType OccupantType? 

  status            UnitStatus        @default(planned)
  progressPercentage Decimal          @default(0) @db.Decimal(5, 2)

  budgetAmount Decimal? @db.Decimal(18, 4)
  actualCost   Decimal  @default(0) @db.Decimal(18, 4)
  currency     String   @db.Char(3)

  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)
  deletedAt DateTime? @db.DateTime(3)
  version   Int       @default(0) @db.UnsignedInt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  rooms   Room[]

  @@unique([companyId, projectId, unitNumber])
  @@index([companyId, projectId, status])
  @@index([companyId, status, deletedAt])
  @@map("units")
}

/// Child of Unit — cascade is correct here because a room has no meaning
/// outside its unit. Dimensions are INTEGER MILLIMETRES (docs/18 ADR-016);
/// the derived areas are denormalised in m² because every BOQ quantity rule
/// starts from them and recomputing on every read would put geometry math in
/// every query path.
model Room {
  id        String @id @db.Char(36)
  companyId String @db.Char(36)
  unitId    String @db.Char(36)

  /// Validated against the domain room-type list in code. The tenant-extensible
  /// room_types lookup table (docs/04 §2.4) lands with tenant customization —
  /// deviation recorded here so it is a known slice, not a forgotten one.
  typeCode String @db.VarChar(40)
  nameEn   String @db.VarChar(120)
  nameAr   String @db.VarChar(120)

  widthMm  Int
  lengthMm Int
  heightMm Int

  floorArea    Decimal @db.Decimal(12, 4)
  wallArea     Decimal @db.Decimal(12, 4)
  ceilingArea  Decimal @db.Decimal(12, 4)
  perimeter    Decimal @db.Decimal(12, 4)
  /// True once a floor-plan polygon owns the geometry; manual edits are then
  /// rejected so the plan and the BOQ cannot disagree. docs/01 ROM-02
  isAreaFromPlan Boolean @default(false)

  sortOrder Int @default(0) @db.SmallInt

  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)
  deletedAt DateTime? @db.DateTime(3)

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([companyId, unitId])
  @@map("rooms")
}

/// Tenant-defined workflow templates. companyId null = the system default
/// 14-stage finishing template every company starts from. docs/01 WFL-01/02
model WorkflowTemplate {
  id        String  @id @db.Char(36)
  companyId String? @db.Char(36)

  code      String  @db.VarChar(64)
  nameEn    String  @db.VarChar(120)
  nameAr    String  @db.VarChar(120)
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)
  version   Int     @default(1)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  stages WorkflowStageTemplate[]

  @@unique([companyId, code])
  @@map("workflow_templates")
}

model WorkflowStageTemplate {
  id         String  @id @db.Char(36)
  companyId  String? @db.Char(36)
  templateId String  @db.Char(36)

  code     String @db.VarChar(64)
  nameEn   String @db.VarChar(120)
  nameAr   String @db.VarChar(120)
  sequence Int    @db.SmallInt
  /// Contribution to unit progress. Weights need not sum to anything — the
  /// rollup normalises — so removing a stage does not force re-weighting.
  weight   Decimal @db.Decimal(6, 3)

  requiresApproval Boolean @default(true)
  requiresPhotos   Boolean @default(false)
  minPhotos        Int     @default(0) @db.TinyInt
  color            String? @db.VarChar(16)

  template WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, sequence])
  @@map("workflow_stage_templates")
}

/// One active workflow per unit. Later template edits never retroactively
/// alter running units — instantiation copies the stages. docs/01 WFL-03
model UnitWorkflow {
  id        String @id @db.Char(36)
  companyId String @db.Char(36)
  unitId    String @db.Char(36)

  templateId      String @db.Char(36)
  templateVersion Int

  status             WorkflowStatus @default(active)
  progressPercentage Decimal        @default(0) @db.Decimal(5, 2)
  startedAt          DateTime?      @db.DateTime(3)
  completedAt        DateTime?      @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  version   Int      @default(0) @db.UnsignedInt

  stages UnitStage[]

  @@unique([companyId, unitId])
  @@map("unit_workflows")
}

model UnitStage {
  id             String @id @db.Char(36)
  companyId      String @db.Char(36)
  unitWorkflowId String @db.Char(36)
  /// Denormalised for the two hottest queries: the unit board and the
  /// company-wide overdue list. docs/04 §2.8
  unitId         String @db.Char(36)

  code     String  @db.VarChar(64)
  nameEn   String  @db.VarChar(120)
  nameAr   String  @db.VarChar(120)
  sequence Int     @db.SmallInt
  weight   Decimal @db.Decimal(6, 3)

  status             StageStatus @default(not_started)
  progressPercentage Decimal     @default(0) @db.Decimal(5, 2)

  requiresApproval Boolean @default(true)

  plannedStartDate DateTime? @db.Date
  plannedEndDate   DateTime? @db.Date
  /// Set on the FIRST transition to in_progress and never overwritten —
  /// restarts after rework do not rewrite history. docs/02 §3.8
  actualStartDate  DateTime? @db.DateTime(3)
  actualEndDate    DateTime? @db.DateTime(3)

  completedBy String?   @db.Char(36)
  completedAt DateTime? @db.DateTime(3)
  approvedBy  String?   @db.Char(36)
  approvedAt  DateTime? @db.DateTime(3)

  blockedReason  String? @db.VarChar(500)
  rejectedReason String? @db.VarChar(500)

  workflow UnitWorkflow @relation(fields: [unitWorkflowId], references: [id], onDelete: Cascade)

  @@index([companyId, unitId, sequence])
  @@index([companyId, status, plannedEndDate])
  @@map("unit_stages")
}

/// Append-only stage event log — the field audit trail. No updatedAt, no
/// deletedAt: corrections are new transitions. `clientEventId` is the offline
/// idempotency key so a retried mobile sync cannot double-record. docs/04 §2.8
model StageTransition {
  id          String @id @db.Char(36)
  companyId   String @db.Char(36)
  unitStageId String @db.Char(36)

  fromStatus     StageStatus
  toStatus       StageStatus
  progressBefore Decimal     @db.Decimal(5, 2)
  progressAfter  Decimal     @db.Decimal(5, 2)

  actorUserId   String      @db.Char(36)
  reason        String?     @db.VarChar(500)
  source        EventSource @default(web)
  clientEventId String?     @db.VarChar(64)
  occurredAt    DateTime    @default(now()) @db.DateTime(3)

  @@unique([companyId, clientEventId])
  @@index([companyId, unitStageId, occurredAt])
  @@map("stage_transitions")
}

enum WorkflowStatus {
  active
  completed
  cancelled
}

enum StageStatus {
  not_started
  in_progress
  blocked
  on_hold
  completed
  approved
  rejected
}

/// Transactional outbox.
///
/// Events are inserted in the SAME transaction as the state change, so "the
/// stage was marked complete but nobody was notified" is structurally
/// impossible. A relay polls and publishes. docs/18 ADR-008
model OutboxEvent {
  id        String @id @db.Char(36)
  companyId String @db.Char(36)

  aggregateType String @db.VarChar(80)
  aggregateId   String @db.Char(36)
  eventType     String @db.VarChar(120)
  eventVersion  Int    @default(1)
  actorId       String? @db.Char(36)
  payload       Json

  occurredAt  DateTime  @db.DateTime(3)
  availableAt DateTime  @default(now()) @db.DateTime(3)
  publishedAt DateTime? @db.DateTime(3)
  attempts    Int       @default(0) @db.TinyInt
  lastError   String?   @db.Text

  /// The relay polls on (publishedAt, availableAt) with FOR UPDATE SKIP LOCKED.
  @@index([publishedAt, availableAt])
  @@index([companyId, aggregateType, aggregateId])
  @@map("outbox_events")
}

/// Consumer idempotency. At-least-once delivery guarantees duplicates
/// eventually, so every consumer records what it has already handled.
model ProcessedEvent {
  eventId     String   @db.Char(36)
  consumer    String   @db.VarChar(120)
  processedAt DateTime @default(now()) @db.DateTime(3)

  @@id([eventId, consumer])
  @@map("processed_events")
}

// ─── AI knowledge base ───────────────────────────────────────────────────────
//
// Modelled here rather than queried with raw SQL because raw SQL bypasses the
// tenant extension (docs/11 §4), and these tables are read on a request path.
//
// Only the three tables the engine reads at runtime are modelled. The remaining
// eight kb_* tables (standards, catalogues, stages, estimation) are authored and
// imported by @buildflow/knowledge-base and read by admin tooling, not by this
// request path — they get models when a feature needs them, not before.
//
// TENANCY: rules are split across two tables instead of one table with a
// nullable companyId. The obvious single-table design cannot be scoped safely
// here — the extension injects `companyId = X`, which hides the system rows;
// listing the model as global removes protection from the tenant rows; and
// bypassing the extension is forbidden from a request handler (docs/11 §4).
// Splitting lets each table use the mechanism that actually fits:
//   • KbRule         — product data, identical for every tenant, GLOBAL_MODELS
//   • KbRuleOverride — tenant-owned, companyId NOT NULL, scoped with no exception
// The repository merges them by code, tenant winning. See docs/11 §4.

/// System catalogue of recommendation and validation rules. Product data,
/// shipped and versioned with the application: no tenant owns a row here, and
/// every tenant reads the same set. Imported by @buildflow/knowledge-base.
/// COLUMN NAMING: every field here carries an explicit @map because the kb_*
/// tables are snake_case, unlike the camelCase columns used everywhere else in
/// this schema. That is deliberate, not drift — these tables are authored as
/// portable SQL in @buildflow/knowledge-base and imported by tooling that never
/// loads Prisma, where snake_case is the correct convention. The @map keeps both
/// readers happy; dropping one would break whichever side stopped being mapped.
///
/// ID DEFAULTS: the three kb_* models use `dbgenerated("(UUID())")`, NOT
/// `uuid()`. Prisma's `uuid()` is generated in the client and leaves the column
/// with no database default, so `prisma db push` silently STRIPS the
/// `DEFAULT (UUID())` that the SQL package's CREATE TABLE installs. The
/// importer omits `id`, and its `INSERT IGNORE` then substitutes '' for the
/// first row and rejects every later one as a duplicate primary key — a
/// 93-row seed file lands exactly one row and reports success. Anything
/// written by both Prisma and the SQL package needs the default to live in the
/// database, where both can see it.
///
/// The same applies to updatedAt: `@updatedAt` alone is client-side, so db
/// push creates the column with NO database default, the SQL import omits it,
/// and INSERT IGNORE downgrades the strict-mode error to a warning — leaving
/// zero-dates (0000-00-00) that Prisma then refuses to READ. `@default(now())`
/// puts DEFAULT CURRENT_TIMESTAMP back in the database.
model KbRule {
  id       String       @id @default(dbgenerated("(UUID())")) @db.Char(36)
  code     String       @unique @db.VarChar(80)
  ruleType KbRuleType   @map("rule_type")
  domain   KbRuleDomain
  /// Pre-filter. Must agree with any roomType condition inside `conditions`,
  /// and must be null when the conditions match more than one room type —
  /// otherwise the rule silently never fires. Enforced by kb:verify.
  roomTypeCode String? @map("room_type_code") @db.VarChar(64)

  /// json-rules-engine condition tree. MariaDB 10.4 stores this as LONGTEXT and
  /// enforces only well-formedness, so shape is validated in the domain layer.
  conditions Json
  severity   KbSeverity @default(suggestion)
  messageEn  String     @map("message_en") @db.VarChar(500)
  messageAr  String     @map("message_ar") @db.VarChar(500)
  /// Machine-actionable payload passed through to the client, e.g.
  /// {"add":"lighting_zone","qty":1}. Free-form by design.
  action   Json?
  priority Int     @default(100) @db.SmallInt
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([ruleType, domain, isActive])
  @@index([roomTypeCode])
  @@map("kb_rules")
}

/// A tenant's customisation of the rule catalogue, written from the admin panel.
/// Either overrides a system rule of the same `code` — disabling it, or changing
/// its thresholds, severity or wording — or defines an entirely new tenant rule
/// under a code no system row uses. Fully tenant-scoped.
model KbRuleOverride {
  id        String @id @default(dbgenerated("(UUID())")) @db.Char(36)
  companyId String @map("company_id") @db.Char(36)
  code      String @db.VarChar(80)

  /// Suppresses the system rule of the same code without deleting it, so the
  /// tenant can re-enable it and product updates to that rule are not lost.
  isDisabled Boolean @default(false) @map("is_disabled")

  /// Null means "inherit from the system rule of this code". A new tenant rule
  /// must populate every field, which the repository enforces on read.
  ruleType     KbRuleType?   @map("rule_type")
  domain       KbRuleDomain?
  roomTypeCode String?       @map("room_type_code") @db.VarChar(64)
  conditions   Json?
  severity     KbSeverity?
  messageEn    String?       @map("message_en") @db.VarChar(500)
  messageAr    String?       @map("message_ar") @db.VarChar(500)
  action       Json?
  priority     Int?          @db.SmallInt
  isActive     Boolean       @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("kb_rule_overrides")
}

/// Vocabulary of facts a rule may reference. The admin-panel rule builder
/// renders its field dropdown from this table, so a business user can compose a
/// new rule over existing facts with no deploy. Global — never tenant-scoped.
model KbFact {
  id       String @id @default(dbgenerated("(UUID())")) @db.Char(36)
  factCode String @unique @map("fact_code") @db.VarChar(64)
  labelEn  String @map("label_en") @db.VarChar(120)
  labelAr  String @map("label_ar") @db.VarChar(120)
  dataType KbFactType @map("data_type")
  unit     String? @db.VarChar(16)
  /// For enum facts: the array of allowed codes.
  allowedValues Json?        @map("allowed_values")
  domain        KbFactDomain
  descriptionEn String?      @map("description_en") @db.VarChar(255)
  isActive      Boolean      @default(true) @map("is_active")

  @@map("kb_facts")
}

enum KbRuleType {
  recommendation
  validation
}

enum KbRuleDomain {
  lighting
  electrical
  plumbing
  furniture
  finishing
  progress
  estimation
  general
}

enum KbSeverity {
  suggestion
  info
  warning
  error
  critical
}

enum KbFactType {
  number
  string
  boolean
  enum
}

enum KbFactDomain {
  room
  lighting
  electrical
  plumbing
  furniture
  finishing
  progress
  general
}

// ─── Catalogue ───────────────────────────────────────────────────────────────
//
// Phase 3 sprints 1–2. docs/04 §2.6
//
// TENANCY, and why it differs from the kb_* tables: a material catalogue is the
// TENANT'S, not the product's. SKUs, costs and the brands a contractor actually
// buys are their commercial data, and a product update must not reach in and
// change them. So there are no global material rows and no scoping exception —
// `Material` carries companyId NOT NULL and a starter catalogue is seeded per
// company at provisioning, the same way roles are.
//
// That is the opposite call from KbRule, deliberately. A safety rule SHOULD keep
// receiving product updates; a purchase price should not.
//
// Categories and brands stay global: they are shared vocabulary, like the
// permission catalogue, and a tenant-specific category code would be
// meaningless to the reporting that groups by it. Tenant-defined categories can
// be added when a customer needs one — the column is absent, not nullable, so
// adding it later is an explicit decision rather than an accident.

/// Grouping vocabulary for the catalogue. Global; `parentId` allows one level
/// of nesting (Flooring → Porcelain) without a recursive query at read time.
model MaterialCategory {
  id       String  @id @default(dbgenerated("(UUID())")) @db.Char(36)
  parentId String? @map("parent_id") @db.Char(36)

  code   String @unique @db.VarChar(64)
  nameEn String @map("name_en") @db.VarChar(120)
  nameAr String @map("name_ar") @db.VarChar(120)
  /// Icon key from @buildflow/ui, not a URL: the icon set ships with the app.
  icon   String? @db.VarChar(64)

  /// Applied when a material in this category has no waste factor of its own.
  /// Tiles waste more than paint, and the estimate is wrong either way if the
  /// number is a single global constant. docs/04 §2.6
  defaultWasteFactor Decimal @default(0) @map("default_waste_factor") @db.Decimal(5, 2)

  sortOrder Int     @default(0) @map("sort_order") @db.SmallInt
  isActive  Boolean @default(true) @map("is_active")

  parent   MaterialCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children MaterialCategory[] @relation("CategoryTree")
  materials Material[]

  @@index([parentId, sortOrder])
  @@map("material_categories")
}

/// Manufacturer. Global vocabulary so "Porcelanosa" means one thing in every
/// tenant's reporting.
model Brand {
  id          String  @id @default(dbgenerated("(UUID())")) @db.Char(36)
  name        String  @unique @db.VarChar(120)
  countryCode String? @map("country_code") @db.Char(2)

  isActive Boolean @default(true) @map("is_active")

  materials Material[]

  @@map("brands")
}

/// A material the tenant can specify, price and consume.
model Material {
  id         String  @id @default(dbgenerated("(UUID())")) @db.Char(36)
  companyId  String  @map("company_id") @db.Char(36)
  categoryId String  @map("category_id") @db.Char(36)
  brandId    String? @map("brand_id") @db.Char(36)

  /// Tenant's own stock code. Unique per company, not globally: two contractors
  /// legitimately use "POR-60" for different tiles.
  sku    String  @db.VarChar(64)
  nameEn String  @map("name_en") @db.VarChar(200)
  nameAr String  @map("name_ar") @db.VarChar(200)
  description String? @db.VarChar(500)

  /// The unit everything else converts INTO. Consumption, stock and BOQ lines
  /// are all stored in this unit, so changing it on a material with movements
  /// would silently restate history — the domain refuses.
  baseUom UnitOfMeasureCode @map("base_uom")

  defaultCost Decimal? @map("default_cost") @db.Decimal(18, 4)
  currency    String?  @db.Char(3)

  /// Typed attributes that vary by category — tile size, paint sheen, plank
  /// thickness. JSON because a column per attribute across every category is a
  /// table nobody can read; validated against the category in the domain.
  spec Json?

  /// Overrides the category default when this material is unusually wasteful,
  /// e.g. large-format porcelain. Null means "inherit the category".
  wasteFactor Decimal? @map("waste_factor") @db.Decimal(5, 2)

  /// Links to the knowledge-base finishing catalogue (kb_material_catalog.code)
  /// when this row was seeded from it, so a tenant edit is distinguishable from
  /// a hand-created material and the AI engine can reason about the finish.
  knowledgeCode String? @map("knowledge_code") @db.VarChar(64)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)
  version   Int       @default(0) @db.UnsignedInt

  category    MaterialCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand       Brand?                  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  conversions MaterialUomConversion[]

  @@unique([companyId, sku])
  @@index([companyId, categoryId, isActive])
  @@index([companyId, knowledgeCode])
  @@map("materials")
}

/// How many base units one purchase unit contains.
///
/// Material-specific and never global: a box of 60×60 tiles is 1.44 m², a box of
/// 30×30 is 0.99 m², and a single shared factor would silently mis-order every
/// tile in the catalogue. docs/02 §UnitOfMeasure
model MaterialUomConversion {
  id         String @id @default(dbgenerated("(UUID())")) @db.Char(36)
  companyId  String @map("company_id") @db.Char(36)
  materialId String @map("material_id") @db.Char(36)

  fromUom UnitOfMeasureCode @map("from_uom")
  toUom   UnitOfMeasureCode @map("to_uom")
  /// 6 dp: 1 box → 1.44 m² needs 2, but 1 kg → 0.000833 m³ needs 6.
  factor  Decimal           @db.Decimal(18, 6)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([companyId, materialId, fromUom, toUom])
  @@map("material_uom_conversions")
}

/// Mirrors UnitOfMeasure in @buildflow/core. Kept in sync by a domain test —
/// a value present in one and not the other is a runtime cast waiting to fail.
// ─── Procurement ─────────────────────────────────────────────────────────────
//
// Phase 3 sprints 5–6. docs/04 §2.9
//
// The chain is request → approval → order → receipt, and the receipt is where
// paper meets the ledger: each received line posts a purchase_receipt movement.
// Every table is tenant-owned. Statuses are state machines in the domain; the
// database stores the result, never decides the transition.

model Supplier {
  id        String @id @db.Char(36)
  companyId String @map("company_id") @db.Char(36)

  code   String  @db.VarChar(32)
  nameEn String  @map("name_en") @db.VarChar(200)
  nameAr String  @map("name_ar") @db.VarChar(200)

  contactPerson    String? @map("contact_person") @db.VarChar(120)
  mobile           String? @db.VarChar(20)
  email            String? @db.VarChar(255)
  city             String? @db.VarChar(80)
  taxNumber        String? @map("tax_number") @db.VarChar(32)
  paymentTermsDays Int     @default(0) @map("payment_terms_days") @db.SmallInt

  isActive Boolean @default(true) @map("is_active")
  notes    String? @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  orders PurchaseOrder[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("suppliers")
}

model PurchaseRequest {
  id          String  @id @db.Char(36)
  companyId   String  @map("company_id") @db.Char(36)
  projectId   String  @map("project_id") @db.Char(36)
  unitId      String? @map("unit_id") @db.Char(36)
  unitStageId String? @map("unit_stage_id") @db.Char(36)

  requestNumber String                @map("request_number") @db.VarChar(32)
  status        PurchaseRequestStatus @default(draft)

  requestedBy    String    @map("requested_by") @db.Char(36)
  requestedAt    DateTime  @map("requested_at") @db.DateTime(3)
  requiredByDate DateTime? @map("required_by_date") @db.DateTime(3)

  /// Who approved is WHO MAY NOT have requested — the SELF_APPROVAL guard in
  /// the domain compares these two columns. docs/11 §3
  approvedBy      String?   @map("approved_by") @db.Char(36)
  approvedAt      DateTime? @map("approved_at") @db.DateTime(3)
  rejectionReason String?   @map("rejection_reason") @db.VarChar(500)

  totalEstimated Decimal @default(0) @map("total_estimated") @db.Decimal(18, 4)
  currency       String  @db.Char(3)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  version   Int      @default(0) @db.UnsignedInt

  lines PurchaseRequestLine[]

  @@unique([companyId, requestNumber])
  @@index([companyId, status])
  @@map("purchase_requests")
}

model PurchaseRequestLine {
  id        String @id @db.Char(36)
  companyId String @map("company_id") @db.Char(36)
  requestId String @map("request_id") @db.Char(36)

  materialId  String  @map("material_id") @db.Char(36)
  description String? @db.VarChar(255)

  quantity           Decimal           @db.Decimal(18, 4)
  uom                UnitOfMeasureCode
  estimatedUnitPrice Decimal?          @map("estimated_unit_price") @db.Decimal(18, 4)
  note               String?           @db.VarChar(255)

  request PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([companyId, requestId])
  @@map("purchase_request_lines")
}

model PurchaseOrder {
  id         String  @id @db.Char(36)
  companyId  String  @map("company_id") @db.Char(36)
  requestId  String? @map("request_id") @db.Char(36)
  supplierId String  @map("supplier_id") @db.Char(36)

  poNumber String              @map("po_number") @db.VarChar(32)
  status   PurchaseOrderStatus @default(draft)

  issuedAt             DateTime? @map("issued_at") @db.DateTime(3)
  expectedDeliveryDate DateTime? @map("expected_delivery_date") @db.DateTime(3)

  subtotal  Decimal @default(0) @db.Decimal(18, 4)
  taxAmount Decimal @default(0) @map("tax_amount") @db.Decimal(18, 4)
  total     Decimal @default(0) @db.Decimal(18, 4)
  currency  String  @db.Char(3)
  terms     String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  version   Int      @default(0) @db.UnsignedInt

  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]

  @@unique([companyId, poNumber])
  @@index([companyId, status])
  @@index([companyId, supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id        String @id @db.Char(36)
  companyId String @map("company_id") @db.Char(36)
  poId      String @map("po_id") @db.Char(36)

  materialId String @map("material_id") @db.Char(36)

  quantity  Decimal           @db.Decimal(18, 4)
  uom       UnitOfMeasureCode
  unitPrice Decimal           @map("unit_price") @db.Decimal(18, 4)
  lineTotal Decimal           @map("line_total") @db.Decimal(18, 4)

  /// Running total maintained by the domain as receipts land; the guard
  /// against over-receipt compares against `quantity`.
  receivedQuantity Decimal @default(0) @map("received_quantity") @db.Decimal(18, 4)

  order PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  @@index([companyId, poId])
  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id         String  @id @db.Char(36)
  companyId  String  @map("company_id") @db.Char(36)
  poId       String  @map("po_id") @db.Char(36)
  supplierId String  @map("supplier_id") @db.Char(36)
  unitId     String? @map("unit_id") @db.Char(36)

  receiptNumber String   @map("receipt_number") @db.VarChar(32)
  receivedAt    DateTime @map("received_at") @db.DateTime(3)
  receivedBy    String   @map("received_by") @db.Char(36)
  notes         String?  @db.VarChar(500)

  /// Idempotency for the offline outbox, same contract as stock movements.
  clientEventId String @map("client_event_id") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  order PurchaseOrder      @relation(fields: [poId], references: [id], onDelete: Restrict)
  lines GoodsReceiptLine[]

  @@unique([companyId, clientEventId])
  @@unique([companyId, receiptNumber])
  @@index([companyId, poId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id        String @id @db.Char(36)
  companyId String @map("company_id") @db.Char(36)
  receiptId String @map("receipt_id") @db.Char(36)
  poLineId  String @map("po_line_id") @db.Char(36)

  materialId String @map("material_id") @db.Char(36)

  quantity         Decimal           @db.Decimal(18, 4)
  uom              UnitOfMeasureCode
  rejectedQuantity Decimal           @default(0) @map("rejected_quantity") @db.Decimal(18, 4)
  rejectionReason  String?           @map("rejection_reason") @db.VarChar(255)

  receipt GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([companyId, receiptId])
  @@map("goods_receipt_lines")
}

enum PurchaseRequestStatus {
  draft
  submitted
  approved
  rejected
  converted
  cancelled
}

enum PurchaseOrderStatus {
  draft
  issued
  partially_received
  received
  cancelled
}

// ─── Invoices & cost allocation ──────────────────────────────────────────────
//
// Phase 3 sprint 7. docs/04 §2.9
//
// The invoice is where actual cost becomes real, and the allocation is where it
// becomes attributable: Σ(allocations) = invoice total EXACTLY, to the minor
// unit, or the profitability report leaks halalas nobody can find. An invoice
// is never deleted after payment — it is voided, with a reason, so the money
// trail explains itself the way the stock ledger does.

model Invoice {
  id         String  @id @db.Char(36)
  companyId  String  @map("company_id") @db.Char(36)
  supplierId String  @map("supplier_id") @db.Char(36)
  poId       String? @map("po_id") @db.Char(36)

  invoiceNumber String    @map("invoice_number") @db.VarChar(64)
  invoiceDate   DateTime  @map("invoice_date") @db.DateTime(3)
  dueDate       DateTime? @map("due_date") @db.DateTime(3)

  subtotal  Decimal @db.Decimal(18, 4)
  /// Percent, 0–100. The amount is derived and stored so the printed figures
  /// survive a later rate change.
  taxRate   Decimal @default(0) @map("tax_rate") @db.Decimal(7, 4)
  taxAmount Decimal @default(0) @map("tax_amount") @db.Decimal(18, 4)
  total     Decimal @db.Decimal(18, 4)
  currency  String  @db.Char(3)

  paymentStatus InvoicePaymentStatus @default(unpaid) @map("payment_status")
  paidAmount    Decimal              @default(0) @map("paid_amount") @db.Decimal(18, 4)
  paidAt        DateTime?            @map("paid_at") @db.DateTime(3)
  paymentMethod String?              @map("payment_method") @db.VarChar(40)

  voidReason String? @map("void_reason") @db.VarChar(500)

  notes String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  version   Int      @default(0) @db.UnsignedInt

  lines       InvoiceLine[]
  allocations CostAllocation[]

  /// Per supplier, not per company: two suppliers can both issue "INV-100",
  /// and the same supplier issuing it twice is the duplicate worth catching.
  @@unique([companyId, supplierId, invoiceNumber])
  @@index([companyId, supplierId, invoiceDate])
  @@index([companyId, paymentStatus])
  @@map("invoices")
}

model InvoiceLine {
  id        String @id @db.Char(36)
  companyId String @map("company_id") @db.Char(36)
  invoiceId String @map("invoice_id") @db.Char(36)

  materialId  String? @map("material_id") @db.Char(36)
  description String  @db.VarChar(255)

  quantity  Decimal           @db.Decimal(18, 4)
  uom       UnitOfMeasureCode
  unitPrice Decimal           @map("unit_price") @db.Decimal(18, 4)
  lineTotal Decimal           @map("line_total") @db.Decimal(18, 4)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([companyId, invoiceId])
  @@map("invoice_lines")
}

/// One slice of an invoice attributed to a unit (and optionally a stage).
/// A value-object SET: re-allocating replaces the whole set, because the
/// invariant is over the set, not any row.
model CostAllocation {
  id        String @id @db.Char(36)
  companyId String @map("company_id") @db.Char(36)
  invoiceId String @map("invoice_id") @db.Char(36)

  unitId      String  @map("unit_id") @db.Char(36)
  unitStageId String? @map("unit_stage_id") @db.Char(36)

  amount     Decimal @db.Decimal(18, 4)
  /// The percentage the caller asked for, kept for display; `amount` is the
  /// exact-sum truth derived from it.
  percentage Decimal? @db.Decimal(7, 4)

  allocatedBy String   @map("allocated_by") @db.Char(36)
  allocatedAt DateTime @map("allocated_at") @db.DateTime(3)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([companyId, invoiceId])
  @@index([companyId, unitId])
  @@map("cost_allocations")
}

enum InvoicePaymentStatus {
  unpaid
  partially_paid
  paid
  void
}

// ─── Budgets ─────────────────────────────────────────────────────────────────
//
// Phase 3 sprint 8. docs/04 §2.9
//
// APPEND-ONLY REVISIONS, the same discipline as the stock ledger and for the
// same reason: "the budget was 80k when we started and someone raised it to
// 95k in March" is the sentence a variance argument turns on, and a mutated
// row cannot say it. The current budget for a scope is simply its highest
// revision; every earlier baseline stays readable.

model Budget {
  id        String  @id @db.Char(36)
  companyId String  @map("company_id") @db.Char(36)
  unitId    String  @map("unit_id") @db.Char(36)
  /// NULL = the whole-unit budget. Stage budgets refine it, they do not
  /// replace it — the report shows both levels.
  unitStageId String? @map("unit_stage_id") @db.Char(36)
  /// Lands with the Phase 4 BOQ; a budget can exist before its quantities do.
  boqId String? @map("boq_id") @db.Char(36)

  materialBudget  Decimal @default(0) @map("material_budget") @db.Decimal(18, 4)
  labourBudget    Decimal @default(0) @map("labour_budget") @db.Decimal(18, 4)
  equipmentBudget Decimal @default(0) @map("equipment_budget") @db.Decimal(18, 4)
  overheadBudget  Decimal @default(0) @map("overhead_budget") @db.Decimal(18, 4)
  /// Derived as the sum of the buckets and stored, so the printed baseline
  /// survives any later change to how buckets are defined.
  totalBudget Decimal @map("total_budget") @db.Decimal(18, 4)
  currency    String  @db.Char(3)

  baselineAt DateTime @map("baseline_at") @db.DateTime(3)
  revision   Int      @db.SmallInt
  approvedBy String   @map("approved_by") @db.Char(36)
  /// Why this revision exists. Free on revision 1; the honest answer on 2+.
  revisionReason String? @map("revision_reason") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  /// '' pins uniqueness for the stage-less row — MySQL unique indexes permit
  /// repeated NULLs. Same pattern as material_balances.stageKey.
  stageKey String @map("stage_key") @db.Char(36)

  @@unique([companyId, unitId, stageKey, revision])
  @@index([companyId, unitId])
  @@map("budgets")
}

// ─── Rate cards ──────────────────────────────────────────────────────────────
//
// Phase 4 sprint 3. docs/04 §2.7
//
// EFFECTIVE-DATED PRICING. A BOQ resolves its rates by pricingDate, never by
// "now" (docs/02 §3.7) — so an ACTIVE card's items are immutable, and a price
// change is a NEW card with a new effective window, not an edit. Editing rates
// on a card that priced last month's BOQ would silently restate a signed
// document.
//
// DELIBERATE DEVIATION from docs/04's `company_id NULL = regional default`:
// the tenant extension cannot protect a nullable-companyId table (the injected
// predicate would hide system rows — the WorkflowTemplate trap, see
// tenant-extension.ts). Regional defaults are instead SEEDED per tenant from a
// curated set in code, the same pattern as SYSTEM_ROLES. Every row here is
// tenant-owned and fully protected.

model RateCard {
  id        String @id @db.Char(36)
  companyId String @map("company_id") @db.Char(36)

  name        String  @db.VarChar(160)
  countryCode String  @map("country_code") @db.Char(2)
  /// NULL = country-wide. Resolution prefers an exact city match.
  city     String? @db.VarChar(80)
  currency String  @db.Char(3)

  effectiveFrom DateTime  @map("effective_from") @db.Date
  /// NULL = open-ended, until a later card supersedes it.
  effectiveTo DateTime? @map("effective_to") @db.Date

  isDefault Boolean        @default(false) @map("is_default")
  status    RateCardStatus @default(draft)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  version   Int      @default(0) @db.UnsignedInt

  items RateCardItem[]

  @@unique([companyId, name])
  @@index([companyId, status, effectiveFrom])
  @@map("rate_cards")
}

enum RateCardStatus {
  draft
  active
  archived
}

model RateCardItem {
  id         String @id @db.Char(36)
  companyId  String @map("company_id") @db.Char(36)
  rateCardId String @map("rate_card_id") @db.Char(36)

  /// Optional link to the tenant's own material row; the work item stands alone.
  materialId String? @map("material_id") @db.Char(36)

  workItemCode  String @map("work_item_code") @db.VarChar(64)
  descriptionEn String @map("description_en") @db.VarChar(255)
  descriptionAr String @map("description_ar") @db.VarChar(255)

  uom UnitOfMeasureCode

  materialRate  Decimal @default(0) @map("material_rate") @db.Decimal(18, 4)
  labourRate    Decimal @default(0) @map("labour_rate") @db.Decimal(18, 4)
  equipmentRate Decimal @default(0) @map("equipment_rate") @db.Decimal(18, 4)

  /// Output per crew-day, for duration estimates. NULL = not measured.
  productivityPerDay Decimal? @map("productivity_per_day") @db.Decimal(12, 4)

  card RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)

  @@unique([rateCardId, workItemCode])
  @@index([companyId, rateCardId])
  @@map("rate_card_items")
}

// ─── Finishing packages ──────────────────────────────────────────────────────
//
// Phase 4 sprint 6. docs/04 §2.6, docs/02 §3.6
//
// A package is a TIER DEFINITION: for each (room type, element), which material
// and which quantity rule. Applying one to a unit is what turns 14 rooms into
// 140 BOQ lines, each carrying its formula.
//
// A package version becomes IMMUTABLE once published (docs/02 §3.6 phrases it
// as "once applied to any unit"; publishing is the earlier and stricter line,
// and it is the one a seller can rely on — a quotation that cites "Premium v2"
// must mean the same thing next month). New content is a new version.

model FinishingPackage {
  id        String @id @db.Char(36)
  companyId String @map("company_id") @db.Char(36)

  code          String @db.VarChar(64)
  /// v1, v2 … per code. `version` below is the concurrency column, as everywhere.
  versionNumber Int    @map("version_number") @db.SmallInt

  nameEn String @map("name_en") @db.VarChar(160)
  nameAr String @map("name_ar") @db.VarChar(160)

  tier   PackageTier
  status PackageStatus @default(draft)

  descriptionEn String? @map("description_en") @db.VarChar(1000)
  descriptionAr String? @map("description_ar") @db.VarChar(1000)

  /// The MARKETING number the tenant authors — "from 1,450 SAR/m²". The real
  /// number for a real unit is derived by applying the package to its rooms;
  /// the two are deliberately separate, because one is a promise and the other
  /// is an estimate.
  indicativePricePerSqm Decimal? @map("indicative_price_per_sqm") @db.Decimal(18, 4)
  currency              String   @db.Char(3)

  publishedAt DateTime? @map("published_at") @db.DateTime(3)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  version   Int      @default(0) @db.UnsignedInt

  items PackageItem[]

  @@unique([companyId, code, versionNumber])
  @@index([companyId, status, tier])
  @@map("finishing_packages")
}

enum PackageTier {
  economic
  standard
  premium
  luxury
  vip
  custom
}

enum PackageStatus {
  draft
  published
  archived
}

model PackageItem {
  id        String @id @db.Char(36)
  companyId String @map("company_id") @db.Char(36)
  packageId String @map("package_id") @db.Char(36)

  /// NULL = every room in the unit. Validated against the domain room-type
  /// list in code, like rooms.type_code — the tenant-extensible lookup lands
  /// with tenant customization. docs/04 §2.4
  roomTypeCode String? @map("room_type_code") @db.VarChar(40)

  element PackageElement

  materialId String? @map("material_id") @db.Char(36)
  specTextEn String? @map("spec_text_en") @db.VarChar(255)
  specTextAr String? @map("spec_text_ar") @db.VarChar(255)

  /// The estimation rule computing the quantity. NULL = fixedQuantity per room
  /// (one kitchen sink is one kitchen sink; no formula improves on that).
  ruleCode String? @map("rule_code") @db.VarChar(64)
  /// Constants the rule needs beyond room geometry: coats, coverage, tile size.
  /// Geometry itself is supplied by the room, keyed off `element`.
  ruleInputs Json? @map("rule_inputs")
  /// Used when ruleCode is NULL. 4 dp, in the work item's uom.
  fixedQuantity Decimal? @map("fixed_quantity") @db.Decimal(18, 4)

  /// The rate card item that prices this line. Without a match on the BOQ's
  /// card, the line cannot be priced and generation says so rather than
  /// inventing a rate.
  workItemCode String @map("work_item_code") @db.VarChar(64)

  isOptional         Boolean  @default(false) @map("is_optional")
  upgradePriceDelta  Decimal? @map("upgrade_price_delta") @db.Decimal(18, 4)

  sortOrder Int @default(0) @map("sort_order") @db.SmallInt

  package FinishingPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([companyId, packageId])
  @@map("package_items")
}

/// The finish surfaces and fittings a package specifies. Mirrors
/// room_finish_specs.element (docs/04 §2.5) so the two can be compared.
enum PackageElement {
  floor
  wall
  ceiling
  skirting
  door
  window
  sanitary
  kitchen
  lighting
  ironmongery
}

// ─── BOQ ─────────────────────────────────────────────────────────────────────
//
// Phase 4 sprints 4–5. docs/04 §2.7, docs/02 §3.7
//
// A Boq in status `approved` is IMMUTABLE; edits create a new versionNumber
// (docs/04 calls the document column `version`; renamed here because `version`
// is this codebase's optimistic-concurrency column on every aggregate). Every
// rule-sourced line carries `formula_evaluated` + `formula_inputs` — the pair
// that makes a BOQ defensible when a client disputes a quantity.

model Boq {
  id        String @id @db.Char(36)
  companyId String @map("company_id") @db.Char(36)
  unitId    String @map("unit_id") @db.Char(36)

  /// The DOCUMENT version: v1, v2 … per unit. Approved versions are frozen;
  /// a new version supersedes, never edits.
  versionNumber Int    @map("version_number") @db.SmallInt
  name          String @db.VarChar(200)

  status         BoqStatus    @default(draft)
  finishingLevel FinishLevel? @map("finishing_level")

  /// The package this BOQ was generated from, and WHICH VERSION of it — the
  /// pair, because a package code alone would not say what was quoted.
  packageId      String? @map("package_id") @db.Char(36)
  packageVersion Int?    @map("package_version") @db.SmallInt

  rateCardId  String   @map("rate_card_id") @db.Char(36)
  /// Rates are resolved by THIS date, never by "now". docs/02 §3.7
  pricingDate DateTime @map("pricing_date") @db.Date
  currency    String   @db.Char(3)

  materialTotal  Decimal @default(0) @map("material_total") @db.Decimal(18, 4)
  labourTotal    Decimal @default(0) @map("labour_total") @db.Decimal(18, 4)
  equipmentTotal Decimal @default(0) @map("equipment_total") @db.Decimal(18, 4)
  subtotal       Decimal @default(0) @db.Decimal(18, 4)

  /// subtotal + overhead + profit, BEFORE tax. Stored because it is the basis
  /// every quotation and contract is built on, and re-deriving a chain that
  /// already ran is how two documents come to disagree.
  preTaxTotal Decimal @default(0) @map("pre_tax_total") @db.Decimal(18, 4)

  overheadPercentage Decimal @default(0) @map("overhead_percentage") @db.Decimal(5, 2)
  profitPercentage   Decimal @default(0) @map("profit_percentage") @db.Decimal(5, 2)
  taxPercentage      Decimal @default(0) @map("tax_percentage") @db.Decimal(5, 2)
  grandTotal         Decimal @default(0) @map("grand_total") @db.Decimal(18, 4)

  generatedBy       BoqGeneratedBy @default(manual) @map("generated_by")
  approvedBy        String?        @map("approved_by") @db.Char(36)
  approvedAt        DateTime?      @map("approved_at") @db.DateTime(3)
  supersededByBoqId String?        @map("superseded_by_boq_id") @db.Char(36)
  notes             String?        @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  version   Int      @default(0) @db.UnsignedInt

  sections BoqSection[]
  lines    BoqLine[]

  @@unique([companyId, unitId, versionNumber])
  @@index([companyId, unitId, status])
  @@map("boqs")
}

enum BoqStatus {
  draft
  in_review
  approved
  superseded
  rejected
}

enum BoqGeneratedBy {
  rule_engine
  ai
  manual
  imported
}

model BoqSection {
  id        String @id @db.Char(36)
  companyId String @map("company_id") @db.Char(36)
  boqId     String @map("boq_id") @db.Char(36)

  /// Usually maps to a workflow stage; free-standing sections are legal.
  stageTemplateId String? @map("stage_template_id") @db.Char(36)

  code      String  @db.VarChar(32)
  titleEn   String  @map("title_en") @db.VarChar(160)
  titleAr   String  @map("title_ar") @db.VarChar(160)
  sortOrder Int     @default(0) @map("sort_order") @db.SmallInt
  subtotal  Decimal @default(0) @db.Decimal(18, 4)

  boq Boq @relation(fields: [boqId], references: [id], onDelete: Cascade)

  @@unique([boqId, code])
  @@index([companyId, boqId])
  @@map("boq_sections")
}

model BoqLine {
  id        String @id @db.Char(36)
  companyId String @map("company_id") @db.Char(36)
  boqId     String @map("boq_id") @db.Char(36)
  sectionId String @map("section_id") @db.Char(36)

  roomId     String? @map("room_id") @db.Char(36)
  materialId String? @map("material_id") @db.Char(36)

  workItemCode  String @map("work_item_code") @db.VarChar(64)
  descriptionEn String @map("description_en") @db.VarChar(255)
  descriptionAr String @map("description_ar") @db.VarChar(255)

  uom UnitOfMeasureCode

  quantity          Decimal @map("quantity") @db.Decimal(18, 4)
  wasteFactor       Decimal @default(0) @map("waste_factor") @db.Decimal(5, 2)
  quantityWithWaste Decimal @map("quantity_with_waste") @db.Decimal(18, 4)

  materialRate  Decimal @default(0) @map("material_rate") @db.Decimal(18, 4)
  labourRate    Decimal @default(0) @map("labour_rate") @db.Decimal(18, 4)
  equipmentRate Decimal @default(0) @map("equipment_rate") @db.Decimal(18, 4)
  lineTotal     Decimal @map("line_total") @db.Decimal(18, 4)

  source BoqLineSource
  /// The estimation rule CODE (docs/04 says rule_id; the catalogue's stable
  /// key is the code, and it survives re-seeds where a row id would not).
  ruleCode String? @map("rule_code") @db.VarChar(64)

  /// The defensibility pair: the substituted formula and the inputs it read.
  /// docs/04 §2.7 — this is what answers a disputed quantity.
  formulaEvaluated String? @map("formula_evaluated") @db.VarChar(500)
  formulaInputs    Json?   @map("formula_inputs")

  isOverridden   Boolean @default(false) @map("is_overridden")
  overrideReason String? @map("override_reason") @db.VarChar(500)

  sortOrder Int @default(0) @map("sort_order") @db.SmallInt

  boq Boq @relation(fields: [boqId], references: [id], onDelete: Cascade)

  @@index([companyId, boqId, sectionId])
  @@index([companyId, materialId])
  @@map("boq_lines")
}

enum BoqLineSource {
  rule
  ai
  manual
  package
}

// ─── Quotations ──────────────────────────────────────────────────────────────
//
// Phase 4 sprint 7. docs/04 §2.7, docs/02 §3.7
//
// The client-facing document derived from an APPROVED BOQ. Its money starts
// from the BOQ's pre-tax total and adds the commercial layer — markup, then
// discount, then tax on what is actually payable. Tax last and once: VAT on a
// figure that a later discount reduces is simply the wrong number.
//
// Content freezes on SEND. A quotation the client is holding cannot change
// under them; a new price is a new quotation.

model Quotation {
  id        String @id @db.Char(36)
  companyId String @map("company_id") @db.Char(36)

  boqId  String @map("boq_id") @db.Char(36)
  unitId String @map("unit_id") @db.Char(36)
  /// Forward reference: the CRM context is not built yet, so this carries the
  /// unit's owner client without a foreign key — the same deliberate pattern
  /// as units.owner_client_id. docs/04 §2.2
  clientId String? @map("client_id") @db.Char(36)

  quotationNumber String          @map("quotation_number") @db.VarChar(32)
  status          QuotationStatus @default(draft)

  /// The offer's shelf life. An expired quotation is a historical fact, not a
  /// price anybody can still accept.
  validUntil DateTime @map("valid_until") @db.Date

  /// The client-facing uplift on the BOQ's pre-tax total.
  markupPercentage Decimal @default(0) @map("markup_percentage") @db.Decimal(5, 2)
  /// An absolute concession, applied after markup and before tax.
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(18, 4)
  taxPercentage  Decimal @default(0) @map("tax_percentage") @db.Decimal(5, 2)

  /// Every figure derived and stored, so the sent document explains itself
  /// years later even if the BOQ behind it is superseded.
  basisAmount   Decimal @map("basis_amount") @db.Decimal(18, 4)
  markupAmount  Decimal @map("markup_amount") @db.Decimal(18, 4)
  netAmount     Decimal @map("net_amount") @db.Decimal(18, 4)
  taxAmount     Decimal @map("tax_amount") @db.Decimal(18, 4)
  totalAmount   Decimal @map("total_amount") @db.Decimal(18, 4)
  currency      String  @db.Char(3)

  /// The language the document was issued in. Both are always renderable; this
  /// records which one the client was actually sent.
  language QuotationLanguage @default(ar)

  sentAt      DateTime? @map("sent_at") @db.DateTime(3)
  viewedAt    DateTime? @map("viewed_at") @db.DateTime(3)
  respondedAt DateTime? @map("responded_at") @db.DateTime(3)
  /// Forward reference until the documents context lands: the stored PDF.
  documentId String? @map("document_id") @db.Char(36)

  notes String? @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  version   Int      @default(0) @db.UnsignedInt

  @@unique([companyId, quotationNumber])
  @@index([companyId, unitId, status])
  @@index([companyId, boqId])
  @@map("quotations")
}

enum QuotationStatus {
  draft
  sent
  viewed
  accepted
  rejected
  expired
}

enum QuotationLanguage {
  ar
  en
}

// ─── Stock ledger ────────────────────────────────────────────────────────────
//
// Phase 3 sprints 3–4. docs/04 §stock_movements, docs/02 §3.9
//
// APPEND-ONLY, structurally. No updatedAt, no deletedAt, no version — the
// columns are absent so that mutation is not merely forbidden but inexpressible.
// The single biggest operational loss in finishing work is unexplained material
// shrinkage, and a mutable quantity_used column cannot answer "who changed it,
// when, and from what". A ledger can. Corrections are REVERSAL movements that
// point at what they reverse, so the audit trail survives its own mistakes.

/// One immutable entry in the material ledger.
model StockMovement {
  id          String  @id @db.Char(36)
  companyId   String  @map("company_id") @db.Char(36)
  materialId  String  @map("material_id") @db.Char(36)
  unitId      String  @map("unit_id") @db.Char(36)
  unitStageId String? @map("unit_stage_id") @db.Char(36)
  roomId      String? @map("room_id") @db.Char(36)

  type      StockMovementType
  /// Denormalised from `type` and validated in the domain: a query summing the
  /// ledger must not carry the type→direction mapping in SQL.
  direction StockDirection

  /// Always in the material's BASE unit. Conversion from purchase units happens
  /// at the boundary via the Material aggregate — storing mixed units in a
  /// ledger makes Σ(in) − Σ(out) meaningless.
  quantity Decimal           @db.Decimal(18, 4)
  uom      UnitOfMeasureCode

  unitCost  Decimal? @map("unit_cost") @db.Decimal(18, 4)
  totalCost Decimal? @map("total_cost") @db.Decimal(18, 4)
  currency  String?  @db.Char(3)

  /// What caused this movement (a goods receipt, a stage checklist item, …).
  referenceType String? @map("reference_type") @db.VarChar(40)
  referenceId   String? @map("reference_id") @db.Char(36)

  /// Set on a correcting entry. The original is never touched.
  reversalOfMovementId String? @map("reversal_of_movement_id") @db.Char(36)

  occurredAt DateTime @map("occurred_at") @db.DateTime(3)
  recordedBy String   @map("recorded_by") @db.Char(36)
  source     EventSource

  /// Client-generated idempotency key. The mobile app's offline outbox retries
  /// until acknowledged, so every movement WILL eventually be sent twice; the
  /// unique key makes the second write a no-op instead of phantom stock.
  clientEventId String @map("client_event_id") @db.Char(36)

  note String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([companyId, clientEventId])
  @@index([companyId, unitId, materialId, occurredAt])
  @@index([companyId, unitStageId, type])
  @@map("stock_movements")
}

/// Derived projection over the ledger — NEVER authoritative. docs/04 §2.8
///
/// Rebuilt by full replay of (unit, material) whenever a movement lands, and
/// recomputed nightly by reconciliation. It may be wrong temporarily; it may
/// not be wrong permanently, and drift is always detectable against the ledger.
model MaterialBalance {
  id          String  @id @db.Char(36)
  companyId   String  @map("company_id") @db.Char(36)
  unitId      String  @map("unit_id") @db.Char(36)
  unitStageId String? @map("unit_stage_id") @db.Char(36)
  materialId  String  @map("material_id") @db.Char(36)

  plannedQuantity   Decimal @default(0) @map("planned_quantity") @db.Decimal(18, 4)
  purchasedQuantity Decimal @default(0) @map("purchased_quantity") @db.Decimal(18, 4)
  usedQuantity      Decimal @default(0) @map("used_quantity") @db.Decimal(18, 4)
  wastedQuantity    Decimal @default(0) @map("wasted_quantity") @db.Decimal(18, 4)
  returnedQuantity  Decimal @default(0) @map("returned_quantity") @db.Decimal(18, 4)
  remainingQuantity Decimal @default(0) @map("remaining_quantity") @db.Decimal(18, 4)
  uom               UnitOfMeasureCode

  actualCost Decimal @default(0) @map("actual_cost") @db.Decimal(18, 4)
  currency   String? @db.Char(3)

  lastMovementAt DateTime? @map("last_movement_at") @db.DateTime(3)
  recalculatedAt DateTime  @map("recalculated_at") @db.DateTime(3)

  /// unitStageId is inside the key via a generated-column pattern handled in
  /// the repository: MySQL unique indexes permit repeated NULLs, so uniqueness
  /// for the stage-less row is enforced by always writing '' — never NULL —
  /// into stageKey.
  stageKey String @map("stage_key") @db.Char(36)

  @@unique([companyId, unitId, stageKey, materialId])
  @@index([companyId, unitId])
  @@map("material_balances")
}

enum StockMovementType {
  purchase_receipt
  consumption
  return_to_supplier
  transfer_in
  transfer_out
  wastage
  adjustment
  opening_balance
}

enum StockDirection {
  in
  out
}

enum UnitOfMeasureCode {
  m
  m2
  m3
  pcs
  box
  kg
  litre
  bag
  roll
  set
  man_day
}

enum MeasurementSystem {
  metric
  imperial
}

enum CompanyStatus {
  trial
  active
  past_due
  suspended
  cancelled
}

enum DbMode {
  shared
  dedicated
}

enum UserStatus {
  invited
  active
  suspended
  deactivated
}

enum ProjectStatus {
  planned
  in_progress
  on_hold
  completed
  delivered
  cancelled
}

enum UnitStatus {
  planned
  in_progress
  on_hold
  completed
  delivered
  cancelled
}

/// Drives circulation, socket and service expectations that differ by dwelling
/// type — a villa carries its own riser and needs per-floor Wi-Fi, a studio
/// does not.
enum UnitType {
  apartment
  villa
  duplex
  studio
  office
}

/// The specification tier. The single most-referenced fact in the rule
/// catalogue: it decides whether a recommendation is worth making at all.
enum FinishLevel {
  economy
  standard
  premium
  luxury
}

/// Who lives here. Changes safety rules rather than taste ones — anti-scald
/// mixers for kids and elderly, shuttered sockets where there are children.
enum OccupantType {
  family
  couple
  single
  kids
  elderly
  staff
  guest
}

enum HandoverCondition {
  red_brick
  semi_finished
  fully_finished_renovation
}
