// BuildFlow — Phase 0 schema slice.
//
// Deliberately partial. This covers tenancy, identity, and enough of the
// project hierarchy to prove tenant isolation end to end. The full ~90-table
// schema in docs/04 lands module by module; a schema is only worth writing once
// the code that enforces its invariants exists alongside it.
//
// CONVENTIONS (docs/04 §1):
//   • id       CHAR(36) holding UUIDv7 — time-ordered, offline-generatable
//   • companyId on EVERY tenant-owned table
//   • every tenant-scoped index is prefixed with companyId
//   • money     Decimal(18,4) + currency, never Float
//   • version   optimistic concurrency token on aggregate roots
//   • deletedAt soft delete

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// The tenant. Every other row in the database belongs to exactly one of these.
model Company {
  id       String @id @db.Char(36)
  nameEn   String @db.VarChar(200)
  nameAr   String @db.VarChar(200)
  slug     String @unique @db.VarChar(80)

  countryCode       String  @db.Char(2)
  defaultCurrency   String  @db.Char(3)
  defaultLocale     String  @default("ar-SA") @db.VarChar(10)
  timezone          String  @default("Asia/Riyadh") @db.VarChar(64)
  measurementSystem MeasurementSystem @default(metric)
  /// 0 = Sunday. Sunday in KSA/EG/AE, Monday in the EU. Every working-day
  /// calculation depends on this — a hard-coded Sat/Sun weekend reports every
  /// Gulf project as permanently delayed. docs/12 §5
  weekStartDay      Int     @default(0) @db.TinyInt

  status  CompanyStatus @default(trial)
  /// Enterprise tenants can be moved to their own database with no application
  /// change — the connection registry already resolves per tenant. docs/03 §5.4
  dbMode  DbMode        @default(shared)
  dataRegion String     @default("me-south-1") @db.VarChar(32)

  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)
  deletedAt DateTime? @db.DateTime(3)
  version   Int       @default(0) @db.UnsignedInt

  users    User[]
  projects Project[]
  units    Unit[]

  @@map("companies")
}

model User {
  id        String @id @db.Char(36)
  companyId String @db.Char(36)

  email        String  @db.VarChar(255)
  mobile       String? @db.VarChar(20)
  passwordHash String  @db.VarChar(255)
  firstNameEn  String  @db.VarChar(100)
  lastNameEn   String  @db.VarChar(100)
  firstNameAr  String? @db.VarChar(100)
  lastNameAr   String? @db.VarChar(100)
  locale       String  @default("ar-SA") @db.VarChar(10)

  status          UserStatus @default(invited)
  mfaEnabled      Boolean    @default(false)
  lastLoginAt     DateTime?  @db.DateTime(3)
  failedLoginCount Int       @default(0) @db.TinyInt
  lockedUntil     DateTime?  @db.DateTime(3)

  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)
  deletedAt DateTime? @db.DateTime(3)
  version   Int       @default(0) @db.UnsignedInt

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  roles    UserRole[]
  sessions Session[]

  /// Email is unique PER COMPANY, not globally: the same person may legitimately
  /// be a site engineer at one contractor and a client of another. docs/04 §2.2
  @@unique([companyId, email])
  @@index([companyId, status])
  @@map("users")
}

/// Roles are compositions of fine-grained permissions, never hard-coded checks.
/// companyId is null for system roles shared by every tenant. docs/11 §3.2
model Role {
  id        String  @id @db.Char(36)
  companyId String? @db.Char(36)

  code        String  @db.VarChar(64)
  nameEn      String  @db.VarChar(120)
  nameAr      String  @db.VarChar(120)
  description String? @db.VarChar(255)
  isSystem    Boolean @default(false)
  isDefault   Boolean @default(false)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, code])
  @@map("roles")
}

/// Global catalogue. `resource.action`, e.g. unit.update, cost.view.
model Permission {
  id            String  @id @db.Char(36)
  code          String  @unique @db.VarChar(80)
  resource      String  @db.VarChar(40)
  action        String  @db.VarChar(40)
  module        String  @db.VarChar(40)
  descriptionEn String  @db.VarChar(255)
  descriptionAr String  @db.VarChar(255)
  /// Requires a second reviewer when granted — hard delete, cost override.
  isDangerous   Boolean @default(false)

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Char(36)
  permissionId String @db.Char(36)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @db.Char(36)
  roleId     String   @db.Char(36)
  companyId  String   @db.Char(36)
  assignedBy String?  @db.Char(36)
  assignedAt DateTime @default(now()) @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([companyId, userId])
  @@map("user_roles")
}

/// The ABAC dimension: which projects/units a user may act on. A site engineer
/// with unit.update still only sees their assigned projects. docs/11 §3.1
model UserAssignment {
  id        String @id @db.Char(36)
  companyId String @db.Char(36)
  userId    String @db.Char(36)

  scopeType   AssignmentScope
  scopeId     String   @db.Char(36)
  roleInScope String?  @db.VarChar(64)
  assignedBy  String?  @db.Char(36)
  assignedAt  DateTime @default(now()) @db.DateTime(3)
  revokedAt   DateTime? @db.DateTime(3)

  @@index([companyId, userId, scopeType, scopeId])
  @@map("user_assignments")
}

model Session {
  id        String @id @db.Char(36)
  companyId String @db.Char(36)
  userId    String @db.Char(36)

  deviceId   String? @db.VarChar(120)
  deviceName String? @db.VarChar(120)
  platform   String? @db.VarChar(40)
  ipAddress  String? @db.VarChar(45)
  userAgent  String? @db.VarChar(400)

  createdAt    DateTime  @default(now()) @db.DateTime(3)
  lastSeenAt   DateTime  @default(now()) @db.DateTime(3)
  expiresAt    DateTime  @db.DateTime(3)
  revokedAt    DateTime? @db.DateTime(3)
  revokeReason String?   @db.VarChar(120)

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens RefreshToken[]

  @@index([companyId, userId, revokedAt])
  @@map("sessions")
}

/// Rotating refresh tokens with family-based reuse detection.
///
/// Only the SHA-256 hash is stored — never the token. A database dump must not
/// yield usable credentials. `familyId` links every token descended from one
/// login; presenting an already-used token means it was stolen, and the whole
/// family is revoked. docs/11 §2.3
model RefreshToken {
  id        String @id @db.Char(36)
  companyId String @db.Char(36)
  sessionId String @db.Char(36)
  userId    String @db.Char(36)

  tokenHash String  @db.Char(64)
  familyId  String  @db.Char(36)
  parentId  String? @db.Char(36)

  issuedAt     DateTime  @default(now()) @db.DateTime(3)
  expiresAt    DateTime  @db.DateTime(3)
  usedAt       DateTime? @db.DateTime(3)
  revokedAt    DateTime? @db.DateTime(3)
  revokeReason String?   @db.VarChar(120)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([familyId])
  @@index([companyId, userId])
  @@map("refresh_tokens")
}

/// Append-only. Written INSIDE the same transaction as the change it records —
/// an async audit write that fails leaves a change with no record, which
/// defeats the purpose. No application code may update or delete a row here.
/// docs/04 §4, docs/11 §7
model AuditLog {
  id        String  @id @db.Char(36)
  companyId String  @db.Char(36)

  actorUserId String?   @db.Char(36)
  actorType   ActorType @default(user)

  action      String  @db.VarChar(80)
  entityType  String  @db.VarChar(60)
  entityId    String  @db.Char(36)
  entityLabel String? @db.VarChar(200)

  before        Json?
  after         Json?
  changedFields Json?
  /// Mandatory for stage rejection, cost override, hard delete, permission
  /// change and project hold — enforced in the application layer.
  reason        String? @db.VarChar(500)

  ipAddress String?     @db.VarChar(45)
  userAgent String?     @db.VarChar(400)
  requestId String?     @db.VarChar(64)
  source    EventSource @default(web)

  occurredAt DateTime @default(now()) @db.DateTime(3)

  @@index([companyId, entityType, entityId, occurredAt])
  @@index([companyId, actorUserId, occurredAt])
  @@index([companyId, action, occurredAt])
  @@map("audit_logs")
}

/// Retained 90 days for brute-force detection. Not tenant-scoped by design:
/// a failed login may reference an email that matches no company.
model LoginAttempt {
  id            String   @id @db.Char(36)
  companyId     String?  @db.Char(36)
  email         String   @db.VarChar(255)
  ipAddress     String?  @db.VarChar(45)
  userAgent     String?  @db.VarChar(400)
  success       Boolean
  failureReason String?  @db.VarChar(60)
  attemptedAt   DateTime @default(now()) @db.DateTime(3)

  @@index([email, attemptedAt])
  @@index([ipAddress, attemptedAt])
  @@map("login_attempts")
}

enum AssignmentScope {
  company
  branch
  project
  unit
  client
}

enum ActorType {
  user
  system
  api
  job
}

enum EventSource {
  web
  mobile
  api
  system
}

model Project {
  id        String @id @db.Char(36)
  companyId String @db.Char(36)

  code   String @db.VarChar(32)
  nameEn String @db.VarChar(200)
  nameAr String @db.VarChar(200)

  status          ProjectStatus @default(planned)
  contractValue   Decimal?      @db.Decimal(18, 4)
  currency        String        @db.Char(3)
  plannedStartDate DateTime?    @db.Date
  plannedEndDate   DateTime?    @db.Date
  progressPercentage Decimal    @default(0) @db.Decimal(5, 2)

  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)
  deletedAt DateTime? @db.DateTime(3)
  version   Int       @default(0) @db.UnsignedInt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  units   Unit[]

  @@unique([companyId, code])
  @@index([companyId, status, plannedEndDate])
  @@map("projects")
}

/// A separate aggregate root, NOT a child of Project.
///
/// A tower project may hold 200 units. Loading the project aggregate to update
/// one unit's progress would load hundreds of rows and serialise every
/// concurrent site update behind one version column. docs/18 ADR-006
model Unit {
  id        String @id @db.Char(36)
  companyId String @db.Char(36)
  projectId String @db.Char(36)

  /// May differ from the project's client: a developer's tower contains units
  /// owned by many different end clients. docs/05 §3
  ownerClientId String? @db.Char(36)

  unitNumber String @db.VarChar(32)
  name       String @db.VarChar(200)
  floor      Int?   @db.SmallInt

  grossArea     Decimal @db.Decimal(12, 4)
  ceilingHeight Decimal @default(3.0) @db.Decimal(6, 3)

  handoverCondition HandoverCondition @default(red_brick)
  status            UnitStatus        @default(planned)
  progressPercentage Decimal          @default(0) @db.Decimal(5, 2)

  budgetAmount Decimal? @db.Decimal(18, 4)
  actualCost   Decimal  @default(0) @db.Decimal(18, 4)
  currency     String   @db.Char(3)

  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)
  deletedAt DateTime? @db.DateTime(3)
  version   Int       @default(0) @db.UnsignedInt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  rooms   Room[]

  @@unique([companyId, projectId, unitNumber])
  @@index([companyId, projectId, status])
  @@index([companyId, status, deletedAt])
  @@map("units")
}

/// Child of Unit — cascade is correct here because a room has no meaning
/// outside its unit. Dimensions are INTEGER MILLIMETRES (docs/18 ADR-016);
/// the derived areas are denormalised in m² because every BOQ quantity rule
/// starts from them and recomputing on every read would put geometry math in
/// every query path.
model Room {
  id        String @id @db.Char(36)
  companyId String @db.Char(36)
  unitId    String @db.Char(36)

  /// Validated against the domain room-type list in code. The tenant-extensible
  /// room_types lookup table (docs/04 §2.4) lands with tenant customization —
  /// deviation recorded here so it is a known slice, not a forgotten one.
  typeCode String @db.VarChar(40)
  nameEn   String @db.VarChar(120)
  nameAr   String @db.VarChar(120)

  widthMm  Int
  lengthMm Int
  heightMm Int

  floorArea    Decimal @db.Decimal(12, 4)
  wallArea     Decimal @db.Decimal(12, 4)
  ceilingArea  Decimal @db.Decimal(12, 4)
  perimeter    Decimal @db.Decimal(12, 4)
  /// True once a floor-plan polygon owns the geometry; manual edits are then
  /// rejected so the plan and the BOQ cannot disagree. docs/01 ROM-02
  isAreaFromPlan Boolean @default(false)

  sortOrder Int @default(0) @db.SmallInt

  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)
  deletedAt DateTime? @db.DateTime(3)

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([companyId, unitId])
  @@map("rooms")
}

/// Tenant-defined workflow templates. companyId null = the system default
/// 14-stage finishing template every company starts from. docs/01 WFL-01/02
model WorkflowTemplate {
  id        String  @id @db.Char(36)
  companyId String? @db.Char(36)

  code      String  @db.VarChar(64)
  nameEn    String  @db.VarChar(120)
  nameAr    String  @db.VarChar(120)
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)
  version   Int     @default(1)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  stages WorkflowStageTemplate[]

  @@unique([companyId, code])
  @@map("workflow_templates")
}

model WorkflowStageTemplate {
  id         String  @id @db.Char(36)
  companyId  String? @db.Char(36)
  templateId String  @db.Char(36)

  code     String @db.VarChar(64)
  nameEn   String @db.VarChar(120)
  nameAr   String @db.VarChar(120)
  sequence Int    @db.SmallInt
  /// Contribution to unit progress. Weights need not sum to anything — the
  /// rollup normalises — so removing a stage does not force re-weighting.
  weight   Decimal @db.Decimal(6, 3)

  requiresApproval Boolean @default(true)
  requiresPhotos   Boolean @default(false)
  minPhotos        Int     @default(0) @db.TinyInt
  color            String? @db.VarChar(16)

  template WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, sequence])
  @@map("workflow_stage_templates")
}

/// One active workflow per unit. Later template edits never retroactively
/// alter running units — instantiation copies the stages. docs/01 WFL-03
model UnitWorkflow {
  id        String @id @db.Char(36)
  companyId String @db.Char(36)
  unitId    String @db.Char(36)

  templateId      String @db.Char(36)
  templateVersion Int

  status             WorkflowStatus @default(active)
  progressPercentage Decimal        @default(0) @db.Decimal(5, 2)
  startedAt          DateTime?      @db.DateTime(3)
  completedAt        DateTime?      @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  version   Int      @default(0) @db.UnsignedInt

  stages UnitStage[]

  @@unique([companyId, unitId])
  @@map("unit_workflows")
}

model UnitStage {
  id             String @id @db.Char(36)
  companyId      String @db.Char(36)
  unitWorkflowId String @db.Char(36)
  /// Denormalised for the two hottest queries: the unit board and the
  /// company-wide overdue list. docs/04 §2.8
  unitId         String @db.Char(36)

  code     String  @db.VarChar(64)
  nameEn   String  @db.VarChar(120)
  nameAr   String  @db.VarChar(120)
  sequence Int     @db.SmallInt
  weight   Decimal @db.Decimal(6, 3)

  status             StageStatus @default(not_started)
  progressPercentage Decimal     @default(0) @db.Decimal(5, 2)

  requiresApproval Boolean @default(true)

  plannedStartDate DateTime? @db.Date
  plannedEndDate   DateTime? @db.Date
  /// Set on the FIRST transition to in_progress and never overwritten —
  /// restarts after rework do not rewrite history. docs/02 §3.8
  actualStartDate  DateTime? @db.DateTime(3)
  actualEndDate    DateTime? @db.DateTime(3)

  completedBy String?   @db.Char(36)
  completedAt DateTime? @db.DateTime(3)
  approvedBy  String?   @db.Char(36)
  approvedAt  DateTime? @db.DateTime(3)

  blockedReason  String? @db.VarChar(500)
  rejectedReason String? @db.VarChar(500)

  workflow UnitWorkflow @relation(fields: [unitWorkflowId], references: [id], onDelete: Cascade)

  @@index([companyId, unitId, sequence])
  @@index([companyId, status, plannedEndDate])
  @@map("unit_stages")
}

/// Append-only stage event log — the field audit trail. No updatedAt, no
/// deletedAt: corrections are new transitions. `clientEventId` is the offline
/// idempotency key so a retried mobile sync cannot double-record. docs/04 §2.8
model StageTransition {
  id          String @id @db.Char(36)
  companyId   String @db.Char(36)
  unitStageId String @db.Char(36)

  fromStatus     StageStatus
  toStatus       StageStatus
  progressBefore Decimal     @db.Decimal(5, 2)
  progressAfter  Decimal     @db.Decimal(5, 2)

  actorUserId   String      @db.Char(36)
  reason        String?     @db.VarChar(500)
  source        EventSource @default(web)
  clientEventId String?     @db.VarChar(64)
  occurredAt    DateTime    @default(now()) @db.DateTime(3)

  @@unique([companyId, clientEventId])
  @@index([companyId, unitStageId, occurredAt])
  @@map("stage_transitions")
}

enum WorkflowStatus {
  active
  completed
  cancelled
}

enum StageStatus {
  not_started
  in_progress
  blocked
  on_hold
  completed
  approved
  rejected
}

/// Transactional outbox.
///
/// Events are inserted in the SAME transaction as the state change, so "the
/// stage was marked complete but nobody was notified" is structurally
/// impossible. A relay polls and publishes. docs/18 ADR-008
model OutboxEvent {
  id        String @id @db.Char(36)
  companyId String @db.Char(36)

  aggregateType String @db.VarChar(80)
  aggregateId   String @db.Char(36)
  eventType     String @db.VarChar(120)
  eventVersion  Int    @default(1)
  actorId       String? @db.Char(36)
  payload       Json

  occurredAt  DateTime  @db.DateTime(3)
  availableAt DateTime  @default(now()) @db.DateTime(3)
  publishedAt DateTime? @db.DateTime(3)
  attempts    Int       @default(0) @db.TinyInt
  lastError   String?   @db.Text

  /// The relay polls on (publishedAt, availableAt) with FOR UPDATE SKIP LOCKED.
  @@index([publishedAt, availableAt])
  @@index([companyId, aggregateType, aggregateId])
  @@map("outbox_events")
}

/// Consumer idempotency. At-least-once delivery guarantees duplicates
/// eventually, so every consumer records what it has already handled.
model ProcessedEvent {
  eventId     String   @db.Char(36)
  consumer    String   @db.VarChar(120)
  processedAt DateTime @default(now()) @db.DateTime(3)

  @@id([eventId, consumer])
  @@map("processed_events")
}

enum MeasurementSystem {
  metric
  imperial
}

enum CompanyStatus {
  trial
  active
  past_due
  suspended
  cancelled
}

enum DbMode {
  shared
  dedicated
}

enum UserStatus {
  invited
  active
  suspended
  deactivated
}

enum ProjectStatus {
  planned
  in_progress
  on_hold
  completed
  delivered
  cancelled
}

enum UnitStatus {
  planned
  in_progress
  on_hold
  completed
  delivered
  cancelled
}

enum HandoverCondition {
  red_brick
  semi_finished
  fully_finished_renovation
}
