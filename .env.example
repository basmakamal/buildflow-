# Copy to .env and adjust. The app validates this file at boot via a Zod schema
# and REFUSES TO START on an invalid value — see docs/06 §11.

NODE_ENV=development

# --- Database ---------------------------------------------------------------
DATABASE_URL="mysql://buildflow:buildflow@localhost:3307/buildflow"
# DATABASE_REPLICA_URL=          # optional read replica (Stage 3+)

# --- Redis ------------------------------------------------------------------
REDIS_URL="redis://localhost:6380"

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-minimum-32-characters-long-secret"
JWT_REFRESH_SECRET="change-me-different-minimum-32-char-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

# --- Storage ----------------------------------------------------------------
STORAGE_DRIVER=minio
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="buildflow-media"
S3_REGION="us-east-1"
S3_ACCESS_KEY="buildflow"
S3_SECRET_KEY="buildflow123"

# --- Mail (mailpit in development) ------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025

# --- AI (optional — the platform works fully with AI disabled) --------------
AI_ENABLED=false
# AI_PROVIDER=anthropic
# AI_API_KEY=
AI_MONTHLY_BUDGET_USD=500

# --- Limits & logging -------------------------------------------------------
RATE_LIMIT_MAX=300
LOG_LEVEL=debug
